<?xml version="1.0" encoding="utf-8"?><!--
   Android 12 及以上的备份规则。
   密钥由 Keystore 加密，恢复到新设备后无法解密，因此云端备份和设备迁移都排除。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="provider_secrets.xml" />
        <exclude domain="sharedpref" path="provider_secrets_plain.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="provider_secrets.xml" />
        <exclude domain="sharedpref" path="provider_secrets_plain.xml" />
    </device-transfer>
</data-extraction-rules>
